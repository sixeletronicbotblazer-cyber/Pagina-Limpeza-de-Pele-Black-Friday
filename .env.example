DATABASE_URL=file:/home/z/my-project/db/custom.db

# Token de administração (cadastro de depoimentos via POST /api/testimonials).
# Gere um valor aleatório forte (ex: openssl rand -hex 32) antes de publicar.
ADMIN_TOKEN=troque_pelo_seu_token

# Segredo compartilhado com o webhook da Cakto (header x-cakto-signature).
# Configure o mesmo valor no painel da Cakto e aqui.
CAKTO_WEBHOOK_SECRET=troque_pelo_seu_segredo
