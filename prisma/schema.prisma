// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Depoimentos reais cadastrados pelo produtor.
// Sem registros aprovados, a seção fica oculta na página pública.
model Testimonial {
  id        String   @id @default(cuid())
  comment   String   // comentário curto (~2 linhas)
  firstName String   // primeiro nome
  city      String   // cidade
  uf        String   // UF (2 letras)
  rating    Int      // nota de 1 a 5
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Compras confirmadas no checkout (webhook da Cakto).
// name/city/uf podem ser nulos -> "Uma nova inscrição foi confirmada."
model Purchase {
  id          String   @id @default(cuid())
  externalId  String   @unique // id da transação na Cakto (deduplicação)
  firstName   String?
  city        String?
  uf          String?
  amountBrl   Int?     // valor em centavos (opcional)
  confirmedAt DateTime @default(now())
  rawPayload  String?  // payload bruto para auditoria
}
